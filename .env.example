# bulletproof-prd-platform — example environment configuration
# Copy to .env and edit. See docs/INSTALL.md for the full reference.

# Postgres connection string (required — the app throws on startup if unset).
# Keep ?schema=prd_platform.
DATABASE_URL="postgresql://user:pass@localhost:5432/dbname?schema=prd_platform"

# If set, Claude/Gemini calls go to the HTTP proxy (scripts/cli-proxy.mjs)
# instead of exec-ing local CLIs. Set to http://host.docker.internal:3199 when
# running the app in Docker.
# CLI_PROXY_URL="http://localhost:3199"

# Filesystem path to a governance plugin providing
# governance.lib.llm_threat_detector. Optional — when unset, the PRD content
# security scan is disabled and returns no findings.
# GOVERNANCE_PLUGIN_PATH="/path/to/governance-plugin"

# Override CLI binary paths (defaults: claude / gemini on PATH).
# CLAUDE_CLI_PATH="claude"
# GEMINI_CLI_PATH="gemini"

# Shared access key for the whole app (REQUIRED).
# Every route and page is gated on this; the server returns 503 until it is set.
# Send it as `Authorization: Bearer <key>` or `x-api-key: <key>`; the browser
# login form at /login exchanges it for an httpOnly cookie.
# Generate one with: openssl rand -hex 32
PRD_PLATFORM_API_KEY="change-me-generate-with-openssl-rand-hex-32"
